
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f2f2f2;
    color: #333;
}

/* CABEÇALHO */
header {
    background-color: #ffffff;
    padding: 20px 5%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #ddd;
}

.saldo span {
    font-size: 14px;
    color: #777;
}

.saldo h2 {
    margin-top: 5px;
    font-size: 24px;
}

.botao_entrar {
    text-decoration: none;
    color: #333;
    background-color: #e5e5e5;
    padding: 10px 22px;
    border-radius: 5px;
}

.botao_entrar:hover {
    background-color: #d5d5d5;
}

/* MOVIMENTAÇÕES */
.movimentacoes {
    margin: 40px auto;
    width: 90%;
}

.movimentacoes h2 {
    margin-bottom: 25px;
    font-size: 22px;
}

/* FILTROS */
.filtros {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 25px;
}

.filtros select,
.filtros input,
.filtros button {
    padding: 9px;
    border: 1px solid #ccc;
    border-radius: 4px;
    background-color: #fff;
    color: #333;
}

.filtro-periodo {
    display: flex;
    align-items: center;
    gap: 8px;
}

.filtros button {
    cursor: pointer;
    background-color: #e5e5e5;
    border: none;
    padding: 10px 18px;
}

.filtros button:hover {
    background-color: #d5d5d5;
}

/* TABELA */
table {
    width: 85%;
    margin: 0 auto;
    border-collapse: collapse;
    background-color: #fff;
}

th, td {
    padding: 14px;
    text-align: left;
    border-bottom: 1px solid #ddd;
}

th {
    background-color: #e5e5e5;
    font-weight: bold;
}

tbody tr:nth-child(even) {
    background-color: #f5f5f5;
}

tbody tr:hover {
    background-color: #ebebeb;
}

/* RESPONSIVIDADE */
@media (max-width: 650px) {
    .filtros {
        flex-wrap: wrap;
    }

    .filtro-periodo {
        flex-wrap: wrap;
    }

    table {
        width: 100%;
    }

    .movimentacoes {
        width: 95%;
    }
}
